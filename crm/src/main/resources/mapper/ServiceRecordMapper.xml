<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.dao.ServiceRecordDao">
    
    <resultMap id="serviceMap" type="com.crm.entity.ServiceRecord">
        <id property="id" column="id"/>
        <result property="customerId" column="customer_id"/>
        <result property="type" column="type"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="handler" column="handler"/>
        <result property="result" column="result"/>
        <result property="satisfaction" column="satisfaction"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        
        <association property="customer" javaType="com.crm.entity.Customer">
            <id property="id" column="c_id"/>
            <result property="name" column="c_name"/>
        </association>
        
        <association property="createUser" javaType="com.crm.entity.User">
            <id property="id" column="u_id"/>
            <result property="username" column="u_username"/>
        </association>
    </resultMap>

    <sql id="selectFields">
        sr.*, 
        c.id as c_id, c.name as c_name,
        u.id as u_id, u.username as u_username
    </sql>

    <sql id="joinTables">
        service_record sr
        LEFT JOIN customer c ON sr.customer_id = c.id
        LEFT JOIN user u ON sr.create_user_id = u.id
    </sql>

    <select id="findAll" resultMap="serviceMap">
        SELECT <include refid="selectFields"/>
        FROM <include refid="joinTables"/>
        ORDER BY sr.create_time DESC
    </select>

    <!-- ... 其他SQL语句，注意将表名从customer_service改为service_record ... -->
</mapper> 